[Unit]
Description=LeadSage web app
After=network-online.target
Wants=network-online.target

[Service]
User=leadsage
Group=leadsage
WorkingDirectory=/opt/leadsage/app
Environment=LEADSAGE_HTTPS=1
ExecStart=/opt/leadsage/venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leadsage/app/data

[Install]
WantedBy=multi-user.target
