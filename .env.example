# Copy to .env and fill in what you need. Every line is optional: with none of them,
# LeadSage runs fully on local models and you send emails from your own mail program.

# Email drafts on Groq's free tier (https://console.groq.com). Without a key the local model writes them.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Send approved emails from your mailbox. Gmail: turn on 2-Step Verification, then make an
# app password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Read replies (read-only). Gmail: imap.gmail.com
IMAP_HOST=
IMAP_PORT=993

# Ask for a password before any page opens. Needed before the app is reachable from another machine.
LEADSAGE_PASSWORD=
# A long random string; required when LEADSAGE_PASSWORD is set.
LEADSAGE_SECRET=
# Set to 1 once the app is behind HTTPS.
# LEADSAGE_HTTPS=1

# Local models (Ollama). Defaults shown.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_SECOND_MODEL=qwen3.5:4b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_SUGGEST_MODEL=
# OLLAMA_FALLBACK_MODEL=
